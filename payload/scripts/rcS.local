#!/bin/sh

# pimento initialization
TDE=$(cat /sys/class/input/input0/tde)

if [ ${TDE:0:1} == "1" ] && [ -x /data/codex/recovery_ap.sh ]; then
	echo "*** Codex recovery AP bootmode ***"
	load_modules /etc/modules.wlan
	/data/codex/recovery_ap.sh boot-tde &
	return
fi

# initialize the wlan and wpa_supplicant
if [ ${TDE:0:1} == "1" ] && [ -e /sbin/nart ]; then
	echo "*** TDE bootmode ***"

	# fixed ethernet ip address for manufacturing
	ifconfig eth1 192.168.1.108

	load_modules /etc/modules.tde
	/sbin/nart &
else
	# If hub goes into TDE mode soft reboot.
	if [ ${TDE:0:1} == "1" ]; then
		if [ ! -e /etc/tdeinfo ]; then
			echo "0" > /etc/tdeinfo
		fi
		count=$(cat /etc/tdeinfo)
		if [ $count -lt 5 ]; then
			count=`expr $count + 1`
			echo $count > /etc/tdeinfo
			reboot
		fi
	fi
	# start ethernet dhcp for development boards
	ifup eth1 &

	load_modules /etc/modules.wlan
	/sbin/wlanconfig ath0 create wlandev wifi0 wlanmode sta
	/usr/sbin/wpa_supplicant -s -iath0 -c /etc/wpa_supplicant.conf &
	/usr/bin/netmonitor &
fi

# memory test
if [ -e /etc/memtester ]; then
	LOOPS=$(cat /etc/memtester)
	echo "*** memtester loop=${LOOPS} ***"

	ifup -a
	/usr/sbin/dropbear
	/usr/bin/iperf -s > /dev/null &

	echo 3 > /sys/class/input/input0/led

	if [ -e /cache/memtester.run ]; then
		# previous test crashed
		echo 1 > /sys/class/input/input0/led
		while true; do sleep 60; done
	fi

	echo "" > /cache/memtester.run
	/usr/bin/memtester 4M ${LOOPS} 2>&1 >> /cache/memtester.log
	if [ $? == 0 ]; then
		rm /cache/memtester.run
		echo 4 > /sys/class/input/input0/led
	else
		echo 1 > /sys/class/input/input0/led
	fi
	while true; do sleep 60; done
fi

# Two remotes with a screen (optional, see docs/TWO_SCREEN_REMOTES.md). When
# two_screen.conf asks for it and both files are exactly the builds it was made
# for, a copy of hal that keeps HOT (the link to remotes with a screen) per
# radio slot is bind-mounted over /usr/bin/hal. The copy carries the
# multi-remote changes below as well and takes both settings from
# /var/run/codex_hal_gates, written here: 1 or 0 for two-screen, multi-remote
# and serial mode. hal reads nothing else; without that file it behaves as the
# stock hal. "once" (and "serial-once") is for one boot: the setting is cleared
# before the copy is bound, so the next boot of any kind starts the stock hal.
# hal is watched by the watchdog, so a copy that died at start would restart
# the hub with the setting still on: three boots in a row that didn't stay up
# four minutes and the copy is left alone until the setting is saved again.
codex_two=$(cat /data/codex/two_screen.conf 2>/dev/null)
case "$codex_two" in
1 | once | serial | serial-once) ;;
*) codex_two= ;;
esac
if [ -z "$codex_two" ] && [ -f /data/codex/bin/hal_remotes ]; then
	# Switched off: the copy is no longer needed (it can't be deleted while it is bound).
	rm -f /data/codex/bin/hal_remotes /data/codex/hal_remotes.tries
	echo "$(date) codex two-screen off: removed /data/codex/bin/hal_remotes" >> /cache/codex-init.log
elif [ -n "$codex_two" ] && [ -f /data/codex/bin/hal_remotes ]; then
	codex_hal_md5=$(md5sum /usr/bin/hal)
	codex_hal_remotes_md5=$(md5sum /data/codex/bin/hal_remotes)
	codex_tries=$(cat /data/codex/hal_remotes.tries 2>/dev/null)
	case "$codex_tries" in
	'' | *[!0-9]*) codex_tries=0 ;;
	esac
	codex_gates=10
	if [ "$(cat /data/codex/multi_remote.conf 2>/dev/null)" = "1" ]; then
		codex_gates=11
	fi
	case "$codex_two" in
	serial*) codex_gates=${codex_gates}1 ;;
	*) codex_gates=${codex_gates}0 ;;
	esac
	if [ "${codex_hal_md5%% *}" != "a3fdd823440c43f36e235fe51c45f008" ] ||
		[ "${codex_hal_remotes_md5%% *}" != "84bcb78e4c7e7b7a7e195b9990547fe0" ]; then
		echo "$(date) codex two-screen hal skipped (unexpected hal build)" >> /cache/codex-init.log
	elif [ "$codex_tries" -ge 3 ]; then
		echo "$(date) codex two-screen hal skipped (the last 3 boots with it didn't stay up; save the setting again to retry)" >> /cache/codex-init.log
	else
		case "$codex_two" in
		*once) echo 0 > /data/codex/two_screen.conf ;;
		esac
		if { [ "${codex_two%once}" = "$codex_two" ] || [ "$(cat /data/codex/two_screen.conf 2>/dev/null)" = "0" ]; } &&
			echo "$(expr $codex_tries + 1)" > /data/codex/hal_remotes.tries &&
			echo "$codex_gates" > /var/run/codex_hal_gates &&
			[ "$(cat /var/run/codex_hal_gates 2>/dev/null)" = "$codex_gates" ] &&
			mount -o bind /data/codex/bin/hal_remotes /usr/bin/hal; then
			echo "$(date) codex two-screen hal bound over /usr/bin/hal (setting $codex_two, gates $codex_gates)" >> /cache/codex-init.log
			(
				sleep 240
				pidof hal > /dev/null 2>&1 && echo 0 > /data/codex/hal_remotes.tries
			) &
		else
			rm -f /var/run/codex_hal_gates
			echo "$(date) codex two-screen hal not bound (setting $codex_two: the setting, the gates or the mount failed)" >> /cache/codex-init.log
		fi
	fi
	unset codex_hal_md5 codex_hal_remotes_md5 codex_tries codex_gates
fi
unset codex_two

# Multiple remotes of one model (optional, see docs/MULTI_REMOTE.md). rcS
# starts /usr/bin/hal after sourcing this file; when the owner switched it on
# and both files are exactly the builds it was made for, a copy of hal that
# runs remote threads per slot (and keeps one per model only for remotes
# with a screen and the keyboard) is bind-mounted over it. Anything else boots the stock hal, untouched.
if [ "$(cat /data/codex/multi_remote.conf 2>/dev/null)" != "1" ] && [ -f /data/codex/bin/hal_multiremote ]; then
	# Switched off: the copy is no longer needed (it can't be deleted while it is bound).
	rm -f /data/codex/bin/hal_multiremote
	echo "$(date) codex multi-remote off: removed /data/codex/bin/hal_multiremote" >> /cache/codex-init.log
elif [ "$(cat /data/codex/multi_remote.conf 2>/dev/null)" = "1" ] && [ -f /data/codex/bin/hal_multiremote ] &&
	! grep ' /usr/bin/hal ' /proc/mounts > /dev/null 2>&1; then
	# (not when the two-screen copy above is bound: it does this too)
	codex_hal_md5=$(md5sum /usr/bin/hal)
	codex_hal_multi_md5=$(md5sum /data/codex/bin/hal_multiremote)
	if [ "${codex_hal_md5%% *}" = "a3fdd823440c43f36e235fe51c45f008" ] &&
		[ "${codex_hal_multi_md5%% *}" = "cafdd7930309c7d74a6a41a87642f0c1" ]; then
		mount -o bind /data/codex/bin/hal_multiremote /usr/bin/hal &&
			echo "$(date) codex multi-remote hal bound over /usr/bin/hal" >> /cache/codex-init.log
	else
		echo "$(date) codex multi-remote hal skipped (unexpected hal build)" >> /cache/codex-init.log
	fi
	unset codex_hal_md5 codex_hal_multi_md5
fi

# USB Ethernet over a self-powered OTG adapter (optional, see docs/USB_ETHERNET.md).
if [ -x /data/codex/usb_eth_service.sh ] &&
	grep '^ENABLED=1$' /data/codex/usb_eth.conf >/dev/null 2>&1; then
	/data/codex/usb_eth_service.sh start &
fi

if [ -x /data/codex/init.sh ]; then
	/data/codex/init.sh &
fi

# here be dragons ..
# as Pimento has limited RAM we force the kernel to always overcommit memory
# if we actually run out of memory the OOM killer is let lose, and it will
# result in watchdog reboot
echo 1 > /proc/sys/vm/overcommit_memory

# hardware version
MFG_DATA=/dev/$(grep mfg /proc/mtd | cut -d: -f1)
HW_VERSION=$(sed -n '/hw_ver/{N N N N s/^[^0-9]*\([0-9][0-9]\)/\1/p}' $MFG_DATA)

# initialize bluetooth
BUILDNAME=$(/usr/sbin/bccmd -t bcsp buildname)
case "$BUILDNAME" in
	*A06*) PSKEYS=csr8811-a06.psr ;;
	*A08*) case "$HW_VERSION" in
		00.40) PSKEYS=csr8811-a08-pb1.psr ;;
		*)     PSKEYS=csr8811-a08.psr ;;
	       esac ;;
	*) echo "ERROR no bluetooth?"; return ;;
esac

cat /lib/firmware/$PSKEYS > /tmp/pskeys.psr

# bluetooth address
cat /sys/class/net/ath0/address | sed 's/\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\).*/\&0x0001 = 0x\4 0x\5\6 0x\3 0x\1\2/' >> /tmp/pskeys.psr

# load bluetooth pskeys
/usr/sbin/bccmd -t bcsp psload -r /tmp/pskeys.psr
/usr/sbin/hciattach ttyS0 bcsp
