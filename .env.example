# Required
HUB_HOST=192.168.1.44
HUB_ID=12345678

# Host paths and proxy port
HARMONY_CONFIG_PATH=./data
HARMONY_KEYS_PATH=./keys
HARMONY_PROXY_PORT=8088
SSH_KEY_PATH=/keys/harmony_owner_key
TZ=Etc/UTC

# Hub connection
HUB_SSH_PORT=22
HUB_SSH_USER=root
HUB_WEB_PORT=8080

# MQTT / Home Assistant (disabled by default)
MQTT_ENABLED=false
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_PASSWORD_FILE=
MQTT_BASE_TOPIC=harmony/hub
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_CLIENT_ID=harmony-local-mqtt

# Upstream installer behavior
CLOUD_BLOCKER_ENABLED=true
REBOOT_HUB_AFTER_INSTALL=true
INSTALL_MODE=once
FORCE_INSTALL=false
