{
  "name": "melodious-desktop",
  "productName": "Melodious",
  "version": "2.0.0",
  "private": true,
  "description": "Melodious for macOS — offline Harmony Hub control and Logitech catalog lookup",
  "main": "src/main.js",
  "scripts": {
    "bundle:shell": "sh scripts/bundle-shell.sh",
    "start": "sh scripts/bundle-shell.sh && electron .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "sh scripts/bundle-shell.sh && node --test test/e2e/shell-e2e.mjs",
    "dist": "sh scripts/bundle-shell.sh && electron-builder --mac --arm64 --x64",
    "dist:win": "sh scripts/bundle-shell.sh && electron-builder --win --x64 --publish never",
    "test:dist:win": "node --test test/e2e/packaged-win-e2e.mjs",
    "test:dist": "node --test test/e2e/packaged-e2e.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  }
}
